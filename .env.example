# AgentPay configuration — copy to .env and fill in.
# .env is git-ignored; never commit real secrets.

# --- GitHub OAuth (core login; required) ---
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_c…cret
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/auth/github/callback

# --- Rialo infrastructure (optional; app degrades gracefully without it) ---
# The ONE RPC endpoint used for balance / faucet / payment.
# localnet full node:  http://127.0.0.1:4104   (requires the local full node)
# Uncomment and set RIALO_RPC_URL to a valid Rialo RPC endpoint (e.g. the
# public testnet endpoint provided by your Rialo provider) for chain access
# without the local node. Left unset, AgentPay defaults to the localnet
# endpoint above and reports typed RPC errors if that node is unreachable.
# RIALO_RPC_URL=<RIALO_RPC_ENDPOINT>

# Path to the rialo CLI binary. Optional.
# Lookup order: RIALO_CLI_PATH -> `rialo` on PATH -> installed release path.
# RIALO_CLI_PATH=/usr/local/bin/rialo

# --- AgentPay Venus payment program (optional; enables /api/payment/program/*) ---
# Deployed program ID on the RPC above. Not a secret.
# Empty/unset = program routes are not mounted; /api/payment direct transfer
# remains the payment path.
AGENTPAY_PROGRAM_ID=<YOUR_AGENTPAY_PROGRAM_ID>
# Directory holding the program's wit/ manifest (default: artifact)
# AGENTPAY_PROGRAM_DIR=artifact

# --- Venus program-payment kill-switch (LEAVE COMMENTED BY DEFAULT) ---
# Program-mediated payments (/api/payment/program/*) stay disabled until an
# operator explicitly sets a POSITIVE cap here. Fix-B was verified live on
# testnet 2026-09-28, but this safety gate is deliberately kept: do NOT add
# this to the real .env without an explicit decision. Direct transfers via
# POST /api/payment are the normal payment route.
# AGENTPAY_PROGRAM_TEST_MAX_RLO=0.5

# --- Local development ONLY: creates a login without GitHub OAuth so chain
# flows can be tested from curl. NEVER set this on a deployed server. ---
# DEV_LOGIN_USER_ID=<YOUR_DEV_LOGIN_USER_ID>

# Transfer kill switch (G21.11): 1/true = transfers disabled (503
# TRANSFERS_DISABLED before any state change). Unset/0/false = transfers
# allowed. ANY other value is treated as disabled (fail-safe).
AGENTPAY_DISABLE_TRANSFERS=1

# --- Storage mode (mandatory on hosted deployments): "postgres" uses the
# DATABASE_URL/Neon as the authoritative store (sessions, wallet registry,
# tasks); "filesystem" is local-only legacy. Any other value fails closed.
AGENTPAY_STORAGE_MODE=postgres

# --- Session cookie Secure attribute: MUST be 1 when the app is served
# over public HTTPS (Koyeb/Vercel). Default off keeps plain-HTTP local
# development working.
AGENTPAY_COOKIE_SECURE=1
