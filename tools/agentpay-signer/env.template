# AgentPay Signer Environment Configuration
# Place this file at /etc/agentpay-signer/env with permissions 0600
# DO NOT commit secrets to git. This template has placeholder values.
#
# After editing, run: sudo chmod 600 /etc/agentpay-signer/env

# --- Required: Network binding ---
AGENTPAY_SIGNER_ENDPOINT=127.0.0.1:9000

# --- Required: Store directory (must exist, be 0700, signer-owned) ---
AGENTPAY_SIGNER_STORE=/var/lib/agentpay-signer

# --- Required: Enable actual signing (not just skeleton) ---
AGENTPAY_SIGNER_SIGNING_ENABLED=1

# --- Required: Policy file path (JSON policy IR) ---
# Generate from AgentPay policy via the compiler
AGENTPAY_SIGNER_POLICY=/etc/agentpay-signer/policy.json

# --- Required: Admin secret for authenticated admin operations ---
# At least 32 bytes of random entropy (e.g., from: openssl rand -hex 32)
AGENTPAY_SIGNER_ADMIN_SECRET=

# --- Optional: Provisioning allow-list at startup ---
# Format: agent_id:auth_pubkey,agent_id:auth_pubkey,...
AGENTPAY_SIGNER_PROVISION_AGENTS=

# --- Required: Pinned channel public key ---
# Obtained from: GET /handshake (before pinning)
AGENTPAY_SIGNER_CHANNEL_PUBKEY=

# --- Required: SHA-256 hash of the signer binary ---
# Update via: sha256sum /opt/agentpay-signer/bin/agentpay-signer
# Only change when rebuilding AND verifying the new binary
AGENTPAY_SIGNER_BINARY_PIN=
